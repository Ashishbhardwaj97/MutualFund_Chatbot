# ==============================================================================
# Mutual Fund FAQ Assistant - Environment Configuration Example
# ==============================================================================
# Copy this file to a new file named '.env' and populate the actual secrets.
# Do NOT commit the '.env' file containing active keys to git/version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM API Configurations (Groq)
# ------------------------------------------------------------------------------
# Required for running actual RAG LLM generations with Phase 5.
# If this key is empty or not configured, the system will automatically run in 
# Offline Mock Mode using deterministic answers for local development.
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here

# ------------------------------------------------------------------------------
# 2. Server API Configurations (FastAPI & Uvicorn)
# ------------------------------------------------------------------------------
# Optional: Set the host and port for the local FastAPI server.
API_HOST=127.0.0.1
API_PORT=8000

# ------------------------------------------------------------------------------
# 3. Database & Storage Paths
# ------------------------------------------------------------------------------
# Optional: Override default relative directories for local database and data.
CHROMADB_PATH=data/vectordb
SCRAPED_DATA_PATH=data/parsed
